diff --git a/packages/core/src/util/child-env.ts b/packages/core/src/util/child-env.ts
new file mode 100644
index 00000000..2f57fff2
--- /dev/null
+++ b/packages/core/src/util/child-env.ts
@@ -0,0 +1,8 @@
+/** Não encaminha credenciais do servidor local aos processos filhos. */
+export function childEnv(source: NodeJS.ProcessEnv = process.env): NodeJS.ProcessEnv {
+  const env = { ...source }
+  for (const key of Object.keys(env)) {
+    if (["OPENCODE_SERVER_PASSWORD", "OPENCODE_SERVER_USERNAME"].includes(key.toUpperCase())) delete env[key]
+  }
+  return env
+}
