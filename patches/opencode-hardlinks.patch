diff --git a/packages/opencode/src/tool/hardlink.ts b/packages/opencode/src/tool/hardlink.ts
new file mode 100644
index 00000000..406b9e85
--- /dev/null
+++ b/packages/opencode/src/tool/hardlink.ts
@@ -0,0 +1,15 @@
+import { Effect, Option } from "effect"
+import { FSUtil } from "@opencode-ai/core/fs-util"
+
+// A hard link can point to an inode also reachable outside the project.
+export const verificar = Effect.fn("Passe1.verificarHardlink")(function* (fs: FSUtil.Interface, file: string) {
+  const info = yield* fs.stat(file).pipe(
+    Effect.catchIf(
+      (error) => "reason" in error && error.reason._tag === "NotFound",
+      () => Effect.succeed(undefined),
+    ),
+  )
+  if (info?.type === "File" && (Option.isNone(info.nlink) || info.nlink.value !== 1)) {
+    throw new Error("Arquivo possui múltiplos links ou não é possível verificá-los.")
+  }
+})
