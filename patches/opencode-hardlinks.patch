diff --git a/packages/opencode/src/tool/hardlink.ts b/packages/opencode/src/tool/hardlink.ts
new file mode 100644
index 00000000..3aa85dfb
--- /dev/null
+++ b/packages/opencode/src/tool/hardlink.ts
@@ -0,0 +1,134 @@
+import { Effect, Option } from "effect"
+import { FSUtil } from "@opencode-ai/core/fs-util"
+import fs from "fs/promises"
+import path from "path"
+import type { Interface as FormatInterface } from "../format"
+
+// Refuse links whose target can escape the project or share an inode.
+export const verificar = Effect.fn("Passe1.verificarLinks")(function* (filesystem: FSUtil.Interface, file: string) {
+  const alvo = path.resolve(file)
+  const raiz = path.parse(alvo).root
+  const partes = alvo.slice(raiz.length).split(/[\\/]+/).filter(Boolean)
+  yield* Effect.tryPromise({
+    try: async () => {
+      let atual = raiz
+      for (const parte of partes) {
+        atual = path.join(atual, parte)
+        try {
+          if ((await fs.lstat(atual)).isSymbolicLink()) throw new Error("Caminho contém link simbólico.")
+        } catch (error) {
+          if (error && typeof error === "object" && "code" in error && error.code === "ENOENT") break
+          throw error
+        }
+      }
+    },
+    catch: (error) => error instanceof Error ? error : new Error("Não foi possível verificar os links."),
+  })
+  const info = yield* filesystem.stat(file).pipe(
+    Effect.catchIf(
+      (error) => "reason" in error && error.reason._tag === "NotFound",
+      () => Effect.succeed(undefined),
+    ),
+  )
+  if (info?.type === "File" && (Option.isNone(info.nlink) || info.nlink.value !== 1)) {
+    return yield* Effect.fail(new Error("Arquivo possui múltiplos links ou não é possível verificá-los."))
+  }
+})
+
+
+export function sensitive(filepath: string) {
+  const parts = filepath.toLowerCase().split(/[\\/]+/)
+  const name = parts.at(-1) ?? ""
+  return parts.some((part) => [".ssh", ".aws", ".gnupg", ".config"].includes(part)) ||
+    [".env", ".envrc", ".npmrc", ".pypirc", ".netrc", ".dockerconfigjson", "credentials", "token", "secrets"].includes(name) ||
+    [".env.", "credentials.", "secrets.", "secret.", "token.", "private_key", "id_rsa", "id_ed25519", "id_ecdsa", "service-account"].some((prefix) => name.startsWith(prefix)) ||
+    [".env", ".pem", ".key", ".p12", ".pfx", ".keystore"].some((suffix) => name.endsWith(suffix))
+}
+
+// The helper anchors the path and streams from a single verified handle.
+export async function abrirSeguro(file: string) {
+  const python = process.env.PASSE1_SECURE_PYTHON
+  const root = process.env.PASSE1_SECURE_ROOT
+  if (!python || !root) throw new Error("Leitura segura indisponível: helper não configurado.")
+  const bootstrap = "import sys; sys.path.insert(0,sys.argv[1]); sys.argv=[sys.argv[0],sys.argv[2]]; from passe1_engine.secure_stream import _main; sys.exit(_main())"
+  const child = Bun.spawn([python, "-I", "-c", bootstrap, root, file], { stdout: "pipe", stderr: "pipe" })
+  const metadata = new Response(child.stderr).text()
+  const reader = child.stdout.getReader()
+  const first = await reader.read()
+  async function* chunks() {
+    try {
+      if (!first.done) yield first.value
+      while (true) {
+        const item = await reader.read()
+        if (item.done) break
+        yield item.value
+      }
+      if (await child.exited !== 0) throw new Error("Leitura segura recusada ou arquivo modificado.")
+    } finally {
+      reader.releaseLock()
+      if (child.exitCode === null) child.kill()
+    }
+  }
+  return { sample: first.value ?? new Uint8Array(), chunks: chunks(), metadata, cancel: () => { reader.cancel(); child.kill() } }
+}
+export type Identidade = { arquivo: string[]; pais: string[][] | null }
+export async function lerSeguroComVersao(file: string, limit = Number.POSITIVE_INFINITY) {
+  const opened = await abrirSeguro(file)
+  const parts: Uint8Array[] = []
+  let size = 0
+  for await (const part of opened.chunks) {
+    size += part.length
+    if (size > limit) throw new Error("Arquivo excede o limite de leitura.")
+    parts.push(part)
+  }
+  const identidade = JSON.parse(await opened.metadata) as Identidade
+  if (!Array.isArray(identidade.arquivo) || !(Array.isArray(identidade.pais) || identidade.pais === null)) throw new Error("Identidade de arquivo inválida.")
+  return { bytes: Buffer.concat(parts), identidade }
+}
+export async function lerSeguro(file: string, limit = Number.POSITIVE_INFINITY): Promise<Uint8Array> {
+  return (await lerSeguroComVersao(file, limit)).bytes
+}
+
+export async function gravarSeguro(file: string, previous: string | null, next: string, identidade: Identidade | null = null) {
+  const python = process.env.PASSE1_SECURE_PYTHON
+  const root = process.env.PASSE1_SECURE_ROOT
+  if (!python || !root) throw new Error("Escrita segura indisponível: helper não configurado.")
+  const bootstrap = "import sys; sys.path.insert(0,sys.argv[1]); from passe1_engine.secure_write import _main; sys.exit(_main())"
+  const child = Bun.spawn([python, "-I", "-c", bootstrap, root], { stdin: "pipe", stdout: "ignore", stderr: "pipe" })
+  child.stdin.write(JSON.stringify({ caminho: file, anterior: previous, novo: next, identidade }))
+  child.stdin.end()
+  if (await child.exited !== 0) throw new Error("Escrita segura recusada ou arquivo mudou durante aprovação.")
+}
+
+export const formatarSeguro = (format: FormatInterface, file: string, content: string) =>
+  Effect.gen(function* () {
+    const available = yield* format.status()
+    const skipped = available.some((item) => item.enabled && item.extensions.includes(path.extname(file)))
+    return { content, skipped }
+  })
+
+export async function removerSeguro(file: string, previous: string, identidade: Identidade | null = null) {
+  const python = process.env.PASSE1_SECURE_PYTHON
+  const root = process.env.PASSE1_SECURE_ROOT
+  if (!python || !root) throw new Error("Remoção segura indisponível: helper não configurado.")
+  const bootstrap = "import sys; sys.path.insert(0,sys.argv[1]); from passe1_engine.secure_write import _main; sys.exit(_main())"
+  const child = Bun.spawn([python, "-I", "-c", bootstrap, root], { stdin: "pipe", stdout: "ignore", stderr: "pipe" })
+  child.stdin.write(JSON.stringify({ caminho: file, anterior: previous, operacao: "remover", identidade }))
+  child.stdin.end()
+  if (await child.exited !== 0) throw new Error("Remoção segura recusada ou arquivo mudou durante aprovação.")
+}
+
+export async function buscarSeguro(pattern: string, paths: string[], ripgrep: string) {
+  const python = process.env.PASSE1_SECURE_PYTHON
+  const root = process.env.PASSE1_SECURE_ROOT
+  if (!python || !root) throw new Error("Busca segura indisponível: helper não configurado.")
+  const bootstrap = "import sys; sys.path.insert(0,sys.argv[1]); from passe1_engine.secure_search import _main; sys.exit(_main())"
+  const child = Bun.spawn([python, "-I", "-c", bootstrap, root], { stdin: "pipe", stdout: "pipe", stderr: "pipe" })
+  const output = new Response(child.stdout).text()
+  child.stdin.write(JSON.stringify({ padrao: pattern, caminhos: paths, ripgrep }))
+  child.stdin.end()
+  const [json, status] = await Promise.all([output, child.exited])
+  if (status !== 0) throw new Error("Busca segura recusada.")
+  const items: [string, number, string][] = JSON.parse(json)
+  return items.map(([path, line, text]) => ({ path, line, text }))
+}
