diff --git a/packages/opencode/src/tool/hardlink.ts b/packages/opencode/src/tool/hardlink.ts
new file mode 100644
index 00000000..04e2110d
--- /dev/null
+++ b/packages/opencode/src/tool/hardlink.ts
@@ -0,0 +1,66 @@
+import { Effect, Option } from "effect"
+import { FSUtil } from "@opencode-ai/core/fs-util"
+import fs from "fs/promises"
+import path from "path"
+
+// Refuse links whose target can escape the project or share an inode.
+export const verificar = Effect.fn("Passe1.verificarLinks")(function* (filesystem: FSUtil.Interface, file: string) {
+  const alvo = path.resolve(file)
+  const raiz = path.parse(alvo).root
+  const partes = alvo.slice(raiz.length).split(/[\\/]+/).filter(Boolean)
+  yield* Effect.tryPromise({
+    try: async () => {
+      let atual = raiz
+      for (const parte of partes) {
+        atual = path.join(atual, parte)
+        try {
+          if ((await fs.lstat(atual)).isSymbolicLink()) throw new Error("Caminho contém link simbólico.")
+        } catch (error) {
+          if (error && typeof error === "object" && "code" in error && error.code === "ENOENT") break
+          throw error
+        }
+      }
+    },
+    catch: (error) => error instanceof Error ? error : new Error("Não foi possível verificar os links."),
+  })
+  const info = yield* filesystem.stat(file).pipe(
+    Effect.catchIf(
+      (error) => "reason" in error && error.reason._tag === "NotFound",
+      () => Effect.succeed(undefined),
+    ),
+  )
+  if (info?.type === "File" && (Option.isNone(info.nlink) || info.nlink.value !== 1)) {
+    return yield* Effect.fail(new Error("Arquivo possui múltiplos links ou não é possível verificá-los."))
+  }
+})
+
+
+export function sensitive(filepath: string) {
+  const parts = filepath.toLowerCase().split(/[\\/]+/)
+  const name = parts.at(-1) ?? ""
+  return parts.some((part) => [".ssh", ".aws", ".gnupg", ".config"].includes(part)) ||
+    [".env", ".envrc", ".npmrc", ".pypirc", ".netrc", ".dockerconfigjson", "credentials", "token", "secrets"].includes(name) ||
+    [".env.", "credentials.", "secrets.", "secret.", "token.", "private_key", "id_rsa", "id_ed25519", "id_ecdsa", "service-account"].some((prefix) => name.startsWith(prefix)) ||
+    [".env", ".pem", ".key", ".p12", ".pfx", ".keystore"].some((suffix) => name.endsWith(suffix))
+}
+
+// Read through one descriptor; never reopen a checked path for its contents.
+export async function lerSeguro(file: string): Promise<Uint8Array> {
+  const before = await fs.lstat(file)
+  if (!before.isFile() || before.isSymbolicLink() || before.nlink !== 1) throw new Error("Arquivo inválido ou possui múltiplos links.")
+  const constants = (await import("node:fs")).constants
+  const handle = await fs.open(file, constants.O_RDONLY | (constants.O_NOFOLLOW ?? 0))
+  try {
+    const opened = await handle.stat()
+    if (!opened.isFile() || opened.nlink !== 1 || opened.dev !== before.dev || opened.ino !== before.ino)
+      throw new Error("Arquivo mudou durante a abertura.")
+    if (opened.size > 64 * 1024 * 1024) throw new Error("Arquivo excede o limite de leitura de 64 MiB.")
+    const bytes = await handle.readFile()
+    const after = await handle.stat()
+    if (after.nlink !== 1 || after.size !== opened.size || after.mtimeMs !== opened.mtimeMs || after.ctimeMs !== opened.ctimeMs)
+      throw new Error("Arquivo mudou durante a leitura.")
+    return bytes
+  } finally {
+    await handle.close()
+  }
+}
